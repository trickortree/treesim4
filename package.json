{
  "name": "hypergamous-tree-chopping-simulator-4",
  "version": "1.1.1",
  "description": "Hypergamous Tree Chopping Simulator 4",
  "author": "Tree Chop Studios",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "three": "0.170.0"
  },
  "build": {
    "appId": "com.trickortree.treesim4",
    "productName": "Hypergamous Tree Chopping Simulator 4",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "game.js",
      "intro.js",
      "updater.js",
      "preload.js",
      "main.js",
      "package.json",
      "build/**/*",
      "vendor/**/*",
      "assets/**/*",
      "!node_modules/three/{src,docs,examples}/**",
      "!node_modules/three/build/{three.cjs,three.webgpu*.js,three.tsl*.js,three.module.min.js}"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TreeChopSim4-Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "trickortree",
      "repo": "treesim4",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotes": "Hypergamous Tree Chopping Simulator 4 - 1.1.1\n\n- FIXED: the camera sometimes flew up or down on its own when moving the mouse. The game now uses raw mouse input and ignores glitchy mouse jumps.\n- SECRET CAVE: somewhere in the eastern hills of the Highland Isle there is a hidden cave. Follow it all the way down...\n- THE HYPERGAMOUS RELIC: collect all 6 pieces hidden across the Highland Isle (press K to see your progress).\n- REBIRTH 2 now needs all 6 relic pieces + $2,500,000. Talk to the Ferryman to see what you still need. (Rebirth 2 itself is still coming soon.)"
    }
  }
}
