{
  "name": "hypergamous-tree-chopping-simulator-4",
  "version": "1.5.2",
  "description": "Hypergamous Tree Chopping Simulator 4",
  "author": "Tree Chop Studios",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "three": "0.170.0"
  },
  "build": {
    "appId": "com.trickortree.treesim4",
    "productName": "Hypergamous Tree Chopping Simulator 4",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "game.js",
      "intro.js",
      "updater.js",
      "preload.js",
      "main.js",
      "package.json",
      "build/**/*",
      "vendor/**/*",
      "assets/**/*",
      "!node_modules/three/{src,docs,examples}/**",
      "!node_modules/three/build/{three.cjs,three.webgpu*.js,three.tsl*.js,three.module.min.js}"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TreeChopSim4-Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "trickortree",
      "repo": "treesim4",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotes": "Hypergamous Tree Chopping Simulator 4 - 1.5.2 (better ghosts)\n\n- Ghost Lumberjacks now hit with 80% of YOUR axe damage, including every upgrade and enchantment on it. A better axe means much stronger ghosts.\n- Ghosts swing faster, fly faster, search further for trees, and bring back more cash and materials.\n- Ghost Lumberjacks are cheaper, and much cheaper on the later islands."
    }
  }
}
